generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  condominiumId String?

  accounts      Account[]
  sessions      Session[]
  condominium   Condominium? @relation(fields: [condominiumId], references: [id])

  @@index([condominiumId])
}

enum Role {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ApartmentStatus {
  PROPIO
  ARRIENDO
  VACIO
}

enum PersonRole {
  PROPIETARIO
  APODERADO
  RESIDENTE
}

enum AssemblyStatus {
  ABIERTA
  CERRADA
}

enum ParticipantType {
  PROPIETARIO
  APODERADO
}

enum SurveyStatus {
  ACTIVA
  CERRADA
}

enum SurveyType {
  BINARIA
  MULTIPLE
}

enum PQRSType {
  PREGUNTA
  QUEJA
  RECLAMO
  SUGERENCIA
}

enum PQRSStatus {
  PENDIENTE
  RESUELTO
  RECHAZADO
  SIN_LEER
}

model Condominium {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apartments   Apartment[]
  people       Person[]
  assemblies   Assembly[]
  announcements Announcement[]
  users        User[]
  pqrs         PQRSRequest[]
}

model Apartment {
  id            String           @id @default(cuid())
  number        String
  tower         String
  level         Int
  status        ApartmentStatus  @default(PROPIO)
  observations  String?
  inhabitants   Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  condominiumId String
  deletedAt     DateTime?

  condominium       Condominium        @relation(fields: [condominiumId], references: [id])
  personApartments  PersonApartment[]
  assemblyParticipants AssemblyParticipant[]
  votes             Vote[]
  pqrs              PQRSRequest[]

  @@unique([number, tower, condominiumId])
  @@index([condominiumId])
  @@index([status])
}

model Person {
  id        String    @id @default(cuid())
  name      String
  idNumber  String
  phone     String?
  email     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  condominiumId String
  deletedAt DateTime?

  condominium       Condominium        @relation(fields: [condominiumId], references: [id])
  personApartments  PersonApartment[]
  assemblyParticipants AssemblyParticipant[]

  @@unique([idNumber, condominiumId])
  @@index([condominiumId])
}

model PersonApartment {
  id          String      @id @default(cuid())
  role        PersonRole
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  personId    String
  apartmentId String

  person     Person     @relation(fields: [personId], references: [id])
  apartment  Apartment  @relation(fields: [apartmentId], references: [id])

  @@unique([personId, apartmentId])
  @@index([apartmentId])
  @@index([personId])
}

model Assembly {
  id        String         @id @default(cuid())
  title     String
  date      DateTime
  status    AssemblyStatus @default(ABIERTA)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  condominiumId String
  deletedAt DateTime?

  condominium  Condominium           @relation(fields: [condominiumId], references: [id])
  surveys       Survey[]
  participants  AssemblyParticipant[]

  @@index([condominiumId])
  @@index([status])
}

model AssemblyParticipant {
  id            String           @id @default(cuid())
  type          ParticipantType
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  assemblyId    String
  apartmentId   String
  personId      String

  assembly   Assembly    @relation(fields: [assemblyId], references: [id])
  apartment  Apartment   @relation(fields: [apartmentId], references: [id])
  person     Person      @relation(fields: [personId], references: [id])

  @@unique([assemblyId, apartmentId])
  @@index([assemblyId])
}

model Survey {
  id        String        @id @default(cuid())
  question  String
  order     Int           @default(0)
  status    SurveyStatus  @default(ACTIVA)
  type      SurveyType    @default(MULTIPLE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  assemblyId String
  deletedAt DateTime?

  assembly   Assembly     @relation(fields: [assemblyId], references: [id])
  options    SurveyOption[]
  votes      Vote[]

  @@index([assemblyId])
  @@index([status])
}

model SurveyOption {
  id        String   @id @default(cuid())
  text      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  surveyId  String

  survey Survey @relation(fields: [surveyId], references: [id])
  votes  Vote[]

  @@index([surveyId])
}

model Vote {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  apartmentId   String
  optionId      String
  surveyId      String
  deletedAt     DateTime?

  apartment  Apartment    @relation(fields: [apartmentId], references: [id])
  option      SurveyOption @relation(fields: [optionId], references: [id])
  survey      Survey       @relation(fields: [surveyId], references: [id])

  @@unique([apartmentId, surveyId])
  @@index([apartmentId])
  @@index([surveyId])
  @@index([deletedAt])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  condominiumId String
  deletedAt   DateTime?

  condominium Condominium @relation(fields: [condominiumId], references: [id])

  @@index([condominiumId])
}

model PQRSRequest {
  id           String      @id @default(cuid())
  type         PQRSType
  subject      String
  description  String      @db.Text
  fullName     String
  email        String
  phone        String
  tower        String
  number       Int
  status       PQRSStatus  @default(SIN_LEER)
  date         DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  condominiumId String
  apartmentId   String?

  condominium  Condominium? @relation(fields: [condominiumId], references: [id])
  apartment    Apartment?   @relation(fields: [apartmentId], references: [id])

  @@index([condominiumId])
  @@index([status])
  @@index([type])
}